# =============================================================================
# SkyLens Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for the data sources you use.
# Not all providers are required -- configure only the ones you need.

# -----------------------------------------------------------------------------
# OpenSky Network (https://opensky-network.org)
# -----------------------------------------------------------------------------
# Free account: https://opensky-network.org/index.php/-/register
# Anonymous access is supported but rate-limited. Authenticated requests
# get higher rate limits (up to 10 req/10 sec vs 5 req/10 sec).
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# -----------------------------------------------------------------------------
# ADS-B Exchange (https://www.adsbexchange.com)
# -----------------------------------------------------------------------------
# API key required. Obtain one via https://www.adsbexchange.com/data/
# The base URL can be overridden if you use a self-hosted or proxy endpoint.
ADSBX_API_KEY=
ADSBX_BASE_URL=

# -----------------------------------------------------------------------------
# FlightAware Firehose (https://www.flightaware.com/commercial/firehose/)
# -----------------------------------------------------------------------------
# Commercial streaming feed. Contact FlightAware for API access.
# https://www.flightaware.com/commercial/firehose/documentation
FLIGHTAWARE_API_KEY=

# -----------------------------------------------------------------------------
# WebSocket Feed
# -----------------------------------------------------------------------------
# URL for a generic WebSocket data feed (e.g., a local ADS-B receiver or
# third-party streaming endpoint).
WEBSOCKET_FEED_URL=
