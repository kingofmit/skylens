{
  "name": "@skylens/replay",
  "version": "0.1.0",
  "description": "Flight replay engine with timeline control, speed adjustment, and multi-track synchronization.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/skylens.git",
    "directory": "packages/replay"
  },
  "keywords": ["skylens", "flight", "ads-b", "aviation", "replay", "timeline", "playback"],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@skylens/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
